    {
      "id": "54091179-074e-4ed1-84da-49145ca9da64",
      "name": "Fetch Ashby board",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.ashbyhq.com/posting-api/job-board/{{ encodeURIComponent(String($json.board).trim()) }}?includeCompensation=true",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "13fd8c4d-7163-4b13-a87a-a25d90ebdce6",
      "name": "Normalize postings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One lead per posting. The board name comes from the item that fetched it.\nconst now = new Date().toISOString();\nconst leads = [];\n\n$input.all().forEach((item, i) => {\n  const jobs = item.json.jobs;\n  if (!Array.isArray(jobs)) return; // this board's fetch failed; the other boards still run\n  const board = $('Split boards').itemMatching(i).json.board;\n\n  for (const job of jobs) {\n    if (job.isListed === false) continue;\n    leads.push({\n      json: {\n        lead_key: 'ashby:' + board + ':' + job.id,\n        ats: 'ashby',\n        board: board,\n        job_id: job.id,\n        company: board,\n        title: job.title,\n        location_text: job.location || '',\n        workplace_type: job.workplaceType || '',\n        secondary_locations: (job.secondaryLocations || [])\n          .map((l) => l.location)\n          .filter(Boolean)\n          .join('; '),\n        pay_text: (job.compensation && job.compensation.compensationTierSummary) || '',\n        posting_url: job.jobUrl,\n        apply_url: job.applyUrl,\n        published_at: job.publishedAt || null,\n        last_seen_at: now,\n      },\n    });\n  }\n});\n\nreturn leads;\n"
      }
    },
