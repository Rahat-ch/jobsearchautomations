    {
      "id": "a92e3af9-bb33-41f9-ae15-63a66ec461d5",
      "name": "Build lead messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One Telegram message per lead. Parse mode is HTML, so escape posting text.\nconst esc = (s) => String(s == null ? '' : s)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nreturn $input.all().map(({ json: lead }) => {\n  const where = [lead.location_text, lead.workplace_type].filter(Boolean).join(' · ');\n  const lines = [\n    '<b>' + esc(lead.title) + '</b>',\n    esc(lead.company),\n    'Location: ' + esc(where || 'Location unclear'),\n    'Pay: ' + esc(lead.pay_text || 'Pay not listed'),\n  ];\n  if (lead.published_at) lines.push('Posted: ' + String(lead.published_at).slice(0, 10));\n\n  return {\n    json: {\n      row_id: lead.id,\n      lead_key: lead.lead_key,\n      text: lines.join('\\n'),\n      silent: true,\n      button_text: 'Open posting',\n      button_url: lead.posting_url,\n    },\n  };\n});\n"
      }
    },
